#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>
// function to reverse the string
void reverse(char *bin, int left, int right) {
    while (left < right) {
        char temp = bin[left];
        bin[left] = bin[right];
        bin[right] = temp;
        left++;
        right--;
    }
}

// function to convert decimal to binary
char* decToBinary(int n) {
    int index = 0;
	char* bin = (char*) malloc(32 * sizeof(char));
  
    while (n > 0) {
        int bit = n % 2;
        bin[index++] = '0' + bit;
        n /= 2;
    }
    bin[index] = '\0';
  
	// Reverse the binary string
	reverse(bin, 0, index-1);
  	return bin;
}
int main(int argc, char *argv[])
{
  // Initialize the randomizer using the current timestamp as a seed
  // (The time() function is provided by the <time.h> header file)
  int i = 0;
